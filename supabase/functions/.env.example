# Token for Mapbox Directions used only by the request-trip Edge Function.
# Use the minimal routing scopes described in docs/MAPBOX_SETUP.md.
MAPBOX_SERVER_TOKEN=pk.your_server_routing_token

# Server only. Use an actual secret manager/ignored local file; no values in Git.
# A dedicated Firebase service account with cloudmessaging.messages.create only.
FCM_SERVICE_ACCOUNT_JSON=
# At least 32 random bytes encoded as URL-safe text; scheduler and worker only.
OPERATIONS_WORKER_TOKEN=
# Optional server error-ingest DSN. Missing DSN means local structured logs only.
SENTRY_DSN=
